{
  "name": "gdg-cv-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Computer-vision motion arcade for the GDG club fair stall",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "fetch-models": "node scripts/fetch-models.mjs",
    "fetch-fonts": "node scripts/fetch-fonts.mjs",
    "setup": "npm run fetch-models && npm run fetch-fonts",
    "test": "node --import ./tests/harness.mjs --test \"tests/*.test.ts\"",
    "kiosk": "npm run build && vite preview --port 4173"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
